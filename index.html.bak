                                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="card-link secondary-link">GitHub</a>
                            </div>
                        </div>
                    </article>

                    <!-- Project 3: Web Projects -->
                    <article class="project-card" data-category="web">
                        <div class="project-banner">
                            <div class="project-badge">Web Application</div>
                            <div class="project-mockup mockup-kanban">
