            <!-- ================= SERVICES SECTION VIEW ================= -->
            <section id="services" class="page-view" aria-label="Services View">
                <div class="section-header">
                    <span class="section-subtitle">What I Do</span>
                    <h2 class="section-title">Services & Specialties</h2>
                    <div class="section-divider"></div>
                </div>

                <div class="services-grid">
                    <div class="service-card">
                        <div class="service-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="16 18 22 12 16 6"/>
                                <polyline points="8 6 2 12 8 18"/>
                            </svg>
                        </div>
                        <h3 class="service-title">Web & Software Development</h3>
                        <p class="service-description">
                            Designing and coding functional web applications and software solutions with clean, maintainable, dependency-light code.
                        </p>
                        <ul class="service-features">
                            <li>Vanilla JS, HTML5 & Modern CSS</li>
                            <li>Python, Java, & C# Programming</li>
                            <li>Relational Database Modeling (MySQL)</li>
                            <li>Responsive, Accessible Interface Layouts</li>
                        </ul>
                    </div>

                    <div class="service-card">
                        <div class="service-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect width="18" height="18" x="3" y="3" rx="2"/>
                                <path d="M7 7h10"/>
                                <path d="M7 12h10"/>
                                <path d="M7 17h10"/>
                            </svg>
                        </div>
                        <h3 class="service-title">Homelab & Infrastructure</h3>
                        <p class="service-description">
                            Setting up and maintaining virtualized homelab environments, containers, and resilient self-hosted platforms.
                        </p>
                        <ul class="service-features">
                            <li>Proxmox VE Hypervisor Management</li>
                            <li>Docker Containerization & Stacks</li>
                            <li>Debian & Linux Server Configuration</li>
                            <li>Service Uptime & Resource Monitoring</li>
                        </ul>
                    </div>

                    <div class="service-card">
                        <div class="service-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M2 12h20"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                        </div>
                        <h3 class="service-title">Networking & Systems</h3>
                        <p class="service-description">
                            Configuring secure remote connectivity, internal mesh networks, and reliable infrastructure routing.
                        </p>
                        <ul class="service-features">
                            <li>Tailscale Mesh & Secure VPN Setup</li>
                            <li>DNS Management & Subdomain Routing</li>
                            <li>Windows & Linux System Administration</li>
                            <li>Local & Network Access Control</li>
                        </ul>
                    </div>

                    <div class="service-card">
                        <div class="service-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect width="20" height="14" x="2" y="3" rx="2"/>
                                <line x1="8" y1="21" x2="16" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                            </svg>
                        </div>
                        <h3 class="service-title">Hardware & Legacy Systems</h3>
                        <p class="service-description">
                            Restoring, configuring, and modernizing vintage computing hardware alongside modern PC diagnostic troubleshooting.
                        </p>
                        <ul class="service-features">
                            <li>Legacy OS Configuration & Restoration</li>
                            <li>Hardware Diagnostics & Component Testing</li>
                            <li>Retro Computing Modernization</li>
                            <li>Benchmarking & System Maintenance</li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- ================= PORTFOLIO SECTION VIEW ================= -->
            <section id="portfolio" class="page-view" aria-label="Portfolio View">
