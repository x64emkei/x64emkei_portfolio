                    <button class="filter-btn" data-filter="systems">Systems & Homelab</button>
                    <button class="filter-btn" data-filter="web">Web Projects</button>
                    <button class="filter-btn" data-filter="legacy">Legacy & Hardware</button>
                </div>

                <!-- Projects Grid -->
                <div class="portfolio-grid" id="portfolioGrid">
                    <!-- Project 1: XpressPOINT -->
                    <article class="project-card" data-category="systems">
                        <div class="project-banner">
                            <div class="project-badge">Homelab & Systems</div>
                            <div class="project-mockup mockup-analytics">
