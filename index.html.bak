                            <div class="project-badge">Infrastructure</div>
                            <div class="project-mockup mockup-devlink">
                                <div class="mockup-header">
                                    <span class="mock-dot"></span>
                                    <span class="mock-dot"></span>
                                    <span class="mock-dot"></span>
                                    <span class="mock-title">proxmox-node-cluster</span>
