                                    <div class="mockup-chart-bar h-80"></div>
                                    <div class="mockup-chart-bar h-50"></div>
                                    <div class="mockup-chart-bar h-95"></div>
                                    <div class="mockup-chart-bar h-65"></div>
                                    <div class="mockup-chart-bar h-85"></div>
                                </div>
                            </div>
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">XpressPOINT</h3>
                            <p class="project-description">
                                Homelab management and monitoring portal designed for managing services, networking, and infrastructure.
                            </p>
                            <div class="project-tech-tags">
