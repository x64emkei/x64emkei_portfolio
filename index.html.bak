                            <div class="project-tech-tags">
                                <span class="tech-tag">Vanilla JS</span>
                                <span class="tech-tag">HTML5</span>
                                <span class="tech-tag">CSS3</span>
                                <span class="tech-tag">UI Design</span>
                            </div>
                            <div class="project-links">
                                <a href="#contact" class="card-link primary-link nav-trigger" data-target="contact">View Showcase</a>
                                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="card-link secondary-link">GitHub</a>
                            </div>
                        </div>
                    </article>

                    <!-- Project 4: Legacy Computing Projects -->
                    <article class="project-card" data-category="legacy">
                        <div class="project-banner">
                            <div class="project-badge">Hardware & Restoration</div>
                            <div class="project-mockup mockup-cloud">
                                <div class="mockup-header">
                                    <span class="mock-dot"></span>
                                    <span class="mock-dot"></span>
                                    <span class="mock-dot"></span>
                                    <span class="mock-title">legacy-rig-bios</span>
                                </div>
                                <div class="mockup-body ui-tokens">
                                    <div class="token-circle red"></div>
                                    <div class="token-circle gray-dark"></div>
                                    <div class="token-circle gray-light"></div>
                                </div>
                            </div>
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Legacy Computing Projects</h3>
                            <p class="project-description">
                                Restoration, configuration, and modernization of older computers and operating systems.
                            </p>
                            <div class="project-tech-tags">
                                <span class="tech-tag">Hardware Restoration</span>
                                <span class="tech-tag">Legacy OS</span>
                                <span class="tech-tag">Diagnostics</span>
                                <span class="tech-tag">Troubleshooting</span>
                            </div>
                            <div class="project-links">
                                <a href="#contact" class="card-link primary-link nav-trigger" data-target="contact">Read More</a>
                                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="card-link secondary-link">GitHub</a>
                            </div>
                        </div>
                    </article>
                </div>
            </section>

            <!-- ================= CONTACT SECTION VIEW ================= -->
            <section id="contact" class="page-view" aria-label="Contact View">
                <div class="section-header">
                    <span class="section-subtitle">Get In Touch</span>
                    <h2 class="section-title">Let’s build something.</h2>
                    <div class="section-divider"></div>
                </div>

                <div class="contact-grid">
                    <!-- Info Panel -->
                    <div class="contact-info-panel">
                        <h3 class="contact-panel-title">Let’s connect.</h3>
                        <p class="contact-panel-description">
                            Interested in collaborating, discussing technology, or checking out my projects? Reach out anytime!
                        </p>

                        <div class="contact-action-links">
                            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="contact-chip-link">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                                    <path d="M9 18c-4.51 2-5-2-7-2"/>
                                </svg>
                                <span>GitHub</span>
                            </a>
                            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="contact-chip-link">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                                    <rect width="4" height="12" x="2" y="9"/>
                                    <circle cx="4" cy="4" r="2"/>
                                </svg>
                                <span>LinkedIn</span>
                            </a>
                            <a href="mailto:contact@michaelordenes.dev" class="contact-chip-link">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                </svg>
                                <span>Email</span>
                            </a>
                        </div>

                        <div class="contact-card-list">
                            <div class="contact-item">
                                <div class="contact-item-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect width="20" height="16" x="2" y="4" rx="2"/>
                                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                    </svg>
                                </div>
                                <div class="contact-item-details">
                                    <span class="contact-item-label">Direct Inquiries</span>
                                    <a href="mailto:contact@michaelordenes.dev" class="contact-item-link">contact@michaelordenes.dev</a>
                                </div>
                            </div>

                            <div class="contact-item">
                                <div class="contact-item-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                                        <circle cx="12" cy="10" r="3"/>
                                    </svg>
                                </div>
                                <div class="contact-item-details">
                                    <span class="contact-item-label">Location</span>
                                    <span class="contact-item-text">Laguna, Philippines</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Form Panel -->
                    <div class="contact-form-panel">
                        <form class="contact-form" id="contactForm" novalidate>
                            <div class="form-group">
                                <label for="userName" class="form-label">Your Name</label>
                                <input type="text" id="userName" name="name" class="form-input" placeholder="e.g. Alex" required>
                                <span class="form-error" id="nameError">Please enter your name</span>
                            </div>

                            <div class="form-group">
                                <label for="userEmail" class="form-label">Email Address</label>
                                <input type="email" id="userEmail" name="email" class="form-input" placeholder="e.g. alex@example.com" required>
                                <span class="form-error" id="emailError">Please enter a valid email address</span>
                            </div>

                            <div class="form-group">
                                <label for="userSubject" class="form-label">Subject</label>
                                <input type="text" id="userSubject" name="subject" class="form-input" placeholder="Collaboration / Tech Discussion / Project" required>
                                <span class="form-error" id="subjectError">Please enter a subject</span>
                            </div>

                            <div class="form-group">
                                <label for="userMessage" class="form-label">Message</label>
                                <textarea id="userMessage" name="message" class="form-textarea" rows="5" placeholder="Tell me what you'd like to build or discuss..." required></textarea>
                                <span class="form-error" id="messageError">Message must be at least 10 characters</span>
                            </div>

                            <button type="submit" class="btn btn-primary btn-submit" id="submitBtn">
                                <span class="btn-text">Send Message</span>
                                <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="22" y1="2" x2="11" y2="13"/>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Toast Notification Component -->
    <div class="toast-container" id="toastContainer" role="status" aria-live="polite">
        <div class="toast-card" id="toastCard">
            <div class="toast-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>
            <div class="toast-content">
                <h4 class="toast-title" id="toastTitle">Success!</h4>
                <p class="toast-message" id="toastMessage">Your message has been dispatched successfully.</p>
            </div>
        </div>
    </div>

    <!-- Main Logic -->
    <script src="script.js"></script>
</body>
</html>
