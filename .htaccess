# ==============================================================================
# x64emkei.dev // Apache Configuration & Hardening (Shared Hosting Compatible)
# ==============================================================================

# Disable directory browsing safely
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Set DirectoryIndex to prioritize index.php
DirectoryIndex index.php index.html

# UTF-8 default encoding
AddDefaultCharset UTF-8

# Protect sensitive files and directories from web access
<FilesMatch "^\.|\.env|\.git|\.md$|\.sql$|composer\.json|composer\.lock">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# URL Rewriting & Folder Guard
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Normalize old public PHP URLs without exposing implementation filenames.
    RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
    RewriteRule ^index\.php$ / [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+(about|work|contact|journal|privacy|terms|accessibility|sitemap)\.php[?\s] [NC]
    RewriteRule ^(about|work|contact|journal|privacy|terms|accessibility|sitemap)\.php$ /$1 [R=301,L]

    # Force HTTPS (Cloudflare and shared-host compatible; skip local dev hosts)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct HTTP access to private application folders
    RewriteRule ^(app|bootstrap|config|database|storage/logs|storage/cache) - [F,L]

    # Front Controller rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Security Headers (where mod_headers is enabled on shared host)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# Browser Caching for Static Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
