{
    "name": "x64emkei/portfolio-cms",
    "description": "Production-Ready Personal Developer Portfolio & CMS engineered with PHP 8.3+ and MySQL",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Benedict Ordenes",
            "email": "mordenes@acm.org",
            "homepage": "https://github.com/x64_emkei"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
