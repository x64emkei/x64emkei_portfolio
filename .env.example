# ==============================================================================
# x64emkei.dev // Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO GITHUB.
# Copy this file to .env and configure your hosting/database credentials.
# ==============================================================================

# Application Environment
APP_NAME="x64emkei.dev"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://welcome.x64emkei.dpdns.org
APP_KEY=

# Database Credentials (InfinityFree Production)
DB_CONNECTION=mysql
DB_HOST=your_db_host
DB_PORT=3306
DB_DATABASE=your_db_database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# FTP Deployment Credentials (local only — NEVER commit)
FTP_HOST=ftpupload.net
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password
FTP_PORT=21
FTP_REMOTE_DIR=/welcome.x64emkei.dpdns.org/htdocs

# Session & Security Settings
SESSION_LIFETIME=604800
MAX_UPLOAD_SIZE=8388608
