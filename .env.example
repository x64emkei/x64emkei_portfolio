# Application Environment
APP_NAME="x64emkei.dev"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://x64emkei.dpdns.org

# Database Credentials (InfinityFree or Local MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=x64emkei_portfolio
DB_USERNAME=root
DB_PASSWORD=

# Session & Security Settings
SESSION_LIFETIME=604800
MAX_UPLOAD_SIZE=8388608
