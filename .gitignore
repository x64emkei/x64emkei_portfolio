# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store
*.stackdump

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local Backups & Temporary Archives
*.bak
*.tmp
*.temp
*.zip
*.tar.gz
*.rar
*~
x64emkei_portfolio.zip

# Storage runtime files (preserve directories with .gitkeep)
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/.htaccess
/storage/*.sqlite

# Environment Configuration & Secrets (NEVER commit)
.env
.env.*
!.env.example
config.local.php
ftp.config.php
secrets/
private/
credentials/

# Key / certificate files
*.pem
*.key
*.p12
*.pfx
*.cer

# SQL dump files (may contain sensitive data)
*.sql
*.dump
!database/migrations/*.sql
!database/schema.sql
!database/seed.sql
!database/schema_dump.sql

# Log files
*.log
logs/

# Backups
*.backup

# Composer & Node Dependencies
/vendor/
/node_modules/
dist/
.cache/

# Deployment packages
/deploy/*.zip
/deploy/htdocs/

# Diagnostic & probe scripts (sensitive — excluded from repo)
scripts/check_ftp*.php
scripts/ftp_probe.php
scripts/probe_*.php
scripts/audit_remote*.php
scripts/upload_welcome*.php
scripts/quick_upload*.php
scripts/check_articles.php
