# Storage runtime files (preserve directories with .gitkeep)
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/.htaccess
/storage/*.sqlite

# Environment Configuration & Secrets
.env
.env.local
.env.*.local
!.env.example

# Composer & Node Dependencies
/vendor/
/node_modules/
dist/
.cache/

# Deployment packages
/deploy/*.zip
/deploy/htdocs/
